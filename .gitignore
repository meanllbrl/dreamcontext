*.tsbuildinfo
dashboard/node_modules/
dashboard/dist/
.DS_Store
.claude/

# Marketing video production (Remotion project, renders, VO audio, captured app
# footage). Heavy binary output, and the production line it inherits is another
# project's private material. This repo is public — it never belongs here.
marketing/

# Obsidian vault config — editor-local (created by the excalidraw skill)
.obsidian/

# This project's own brain lives in a separate PRIVATE repo (dreamcontext-brain) and
# links this one as a code repo. Nothing under these folders may ever land here: this
# repo is public. _agent_context/ is the brain's pre-rename name.
/_dream_context
/_agent_context
# Repo-root scratch: where the verify scripts write their screenshots and where one-off
# probes land. Anchored with a leading slash so it can never match a source `tmp/` folder.
/tmp/
# design-sync: staged converter scripts, build output, machine state (durable
# inputs — config.json, NOTES.md, conventions.md, previews/, overrides/ — stay tracked)
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# Playwright
test-results/
playwright-report/
e2e/shots/
.playwright/
.playwright-mcp/

# Local verification screenshots
version-filter-sprint-aware.png

# Scratch downloads (videos, transcripts, media pulled for analysis)
_download/
docs/


# Generated example boards — build artifacts, fully derived from examples/*.js (run them to regenerate)
skill-draw/examples/*.excalidraw.md


# Scratch harness written by scripts/verify/project-chip-status.mjs. The script removes it
# on the way out; this is the safety net for a run that was killed before it could.
dashboard/.verify-harness/

*.tgz
/npm-shrinkwrap.json
