{
  "productName": "dreamcontext-beta",
  "version": "0.34.5",
  "identifier": "com.dreamcontext.beta",
  "build": {
    "frontendDist": "./frontend-placeholder"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../dist": "dist",
      "../../skill-packs": "skill-packs",
      "../../skill": "skill",
      "../../agents": "agents",
      "../../assets": "assets",
      "../../cloud": "cloud",
      "../../skill-initializer": "skill-initializer",
      "../../skill-curator": "skill-curator",
      "../../skill-deep-research": "skill-deep-research",
      "../../skill-sync": "skill-sync",
      "../../skill-patterns": "skill-patterns",
      "../../skill-agent-core": "skill-agent-core",
      "sleepy": "sleepy"
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "12.0",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 480
        },
        "appPosition": {
          "x": 180,
          "y": 180
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 180
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJEN0IxNjJERTc1N0VGQkQKUldTOTcxZm5MUlo3TGNnaHlvRlQ1RDNnNUl0cVR5WVVVTmVodEk1bW1PYW54VlF3YVNLTWd4YkcK",
      "endpoints": [
        "https://github.com/meanllbrl/dreamcontext/releases/latest/download/latest.json"
      ]
    }
  }
}
