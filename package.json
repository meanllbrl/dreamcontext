{
  "name": "dreamcontext",
  "version": "0.30.5",
  "description": "dreamcontext — the persistent brain for your AI agents. Remembers what you built, knows how your project works.",
  "type": "module",
  "bin": {
    "dreamcontext": "./dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "skill",
    "skill-initializer",
    "skill-curator",
    "skill-deep-research",
    "skill-sync",
    "skill-patterns",
    "skill-agent-core",
    "skill-packs",
    "agents",
    "cloud",
    "README.md",
    "LICENSE",
    "NOTICE",
    "install.sh",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "build:dashboard": "cd dashboard && npm run build && cd .. && node scripts/sync-dashboard-dist.mjs",
    "build:cli": "tsup",
    "build": "npm run build:dashboard && npm run build:cli",
    "dev": "tsup --watch",
    "dev:dashboard": "cd dashboard && npm run dev",
    "test": "vitest",
    "test:e2e": "playwright test",
    "verify:people": "node scripts/verify/people-first.mjs",
    "verify:chat-steer": "node scripts/verify/chat-steer.mjs",
    "verify:assistant": "node scripts/verify/assistant.mjs",
    "verify:chat-agent-title": "node scripts/verify/chat-agent-title.mjs",
    "verify:chat-compact": "node scripts/verify/chat-compact.mjs",
    "verify:chat-questions": "node scripts/verify/chat-questions.mjs",
    "verify:train-me": "node scripts/verify/train-me.mjs",
    "verify:chat-scroll": "node scripts/verify/chat-scroll.mjs",
    "verify:past-chats": "node scripts/verify/past-chats.mjs",
    "verify:past-chats-ui": "node scripts/verify/past-chats-ui.mjs",
    "verify:pdf-viewer": "node scripts/verify/pdf-viewer.mjs",
    "verify:file-preview": "node scripts/verify/chat-file-preview.mjs",
    "verify:claude-auth-switch": "node scripts/verify/claude-auth-switch.mjs",
    "diagrams": "node scripts/diagrams/build-all.mjs",
    "prepublishOnly": "npm run build",
    "prepack": "node scripts/shrinkwrap.mjs write",
    "postpack": "node scripts/shrinkwrap.mjs remove",
    "verify:chat-toolrows": "node scripts/verify/chat-toolrows.mjs",
    "verify:chat-browser-live": "node scripts/verify/chat-browser-live.mjs",
    "verify:chat-subagent-report": "node scripts/verify/chat-subagent-report.mjs",
    "verify:chat-quest": "node scripts/verify/chat-quest.mjs",
    "verify:chat-teammates": "node scripts/verify/chat-teammates.mjs",
    "verify:chat-prose": "node scripts/verify/chat-prose.mjs",
    "gen:cli-manifest": "UPDATE_CLI_MANIFEST=1 vitest run tests/unit/cli-manifest.test.ts",
    "gen:lab-mirrors": "node scripts/gen-lab-mirrors.mjs",
    "verify:chat-html": "node scripts/verify/chat-html.mjs",
    "verify:dream-actions": "node scripts/verify/dream-actions.mjs",
    "verify:chat-shelf-ui": "node scripts/verify/chat-shelf-ui.mjs",
    "verify:chat-composer": "node scripts/verify/chat-composer-ui.mjs",
    "verify:chat-mcp": "node scripts/verify/chat-mcp-panel.mjs",
    "verify:chat-secret-run": "node scripts/verify/chat-secret-run.mjs",
    "verify:pane-focus-click": "node scripts/verify/pane-focus-click.mjs",
    "verify:pane-layout-restore": "node scripts/verify/pane-layout-restore.mjs",
    "verify:peer-mail": "node scripts/verify/peer-mail-ui.mjs",
    "verify:chat-shelf": "node scripts/verify/chat-shelf.mjs",
    "verify:automation-run-chat": "node scripts/verify/automation-run-chat.mjs",
    "verify:delegate-modes": "node scripts/verify/delegate-modes.mjs",
    "verify:hypotheses": "node scripts/verify/hypotheses-ui.mjs",
    "verify:lab-boards": "node scripts/verify/lab-boards.mjs",
    "verify:funnel-explorer": "node scripts/verify/funnel-explorer.mjs",
    "verify:whiteboard": "node scripts/verify/whiteboard.mjs",
    "verify:whiteboard-agent": "node scripts/verify/whiteboard-agent.mjs",
    "verify:whiteboard-agent-panel": "node scripts/verify/whiteboard-agent-panel.mjs",
    "verify:whiteboard-polish": "node scripts/verify/whiteboard-polish.mjs",
    "verify:project-tabs": "node scripts/verify/project-tabs.mjs",
    "verify:project-chip-status": "node scripts/verify/project-chip-status.mjs",
    "verify:automations": "node scripts/verify/automations.mjs",
    "verify:agents-members": "node scripts/verify/agents-members.mjs",
    "verify:agent-slots": "node scripts/verify/agent-schedule-slots.mjs",
    "verify:agents-feed": "node scripts/verify/agents-feed.mjs",
    "verify:agent-threads": "node scripts/verify/agent-threads.mjs",
    "verify:agent-attachments": "node scripts/verify/agent-attachments.mjs",
    "verify:sidebar-rail": "node scripts/verify/sidebar-rail.mjs",
    "verify:task-delete": "node scripts/verify/task-delete-confirm.mjs",
    "verify:task-backlog": "node scripts/verify/task-backlog-and-tags.mjs",
    "verify:lab-app": "node scripts/verify/lab-app-insight.mjs",
    "verify:chat-segments": "node scripts/verify/chat-segments.mjs",
    "verify:node-setup-page": "node scripts/verify/node-setup-page.mjs",
    "verify:onboarding": "node scripts/verify/onboarding.mjs",
    "announce:shots:gap": "node e2e/announce-shots-gap.mjs",
    "announce:shots:chat-html": "node e2e/announce-shots-chat-html.mjs",
    "verify:pane-widen": "node scripts/verify/pane-focus-widen.mjs",
    "verify:chat-smooth": "node scripts/verify/chat-smooth.mjs",
    "verify:mobile-chat": "node scripts/verify/mobile-chat.mjs",
    "verify:sleep-debt": "vitest run --config eval/sleep-debt/vitest.config.ts"
  },
  "keywords": [
    "ai",
    "agent",
    "context",
    "memory",
    "brain",
    "cli",
    "claude",
    "gemini",
    "llm"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "fractional-indexing": "^4.0.0",
    "gray-matter": "^4.0.3",
    "nanoid": "^5.1.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.13.4",
    "@types/ws": "^8.18.1",
    "sharp": "^0.34.5",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "node-pty": "^1.1.0"
  }
}
