{
  "name": "dreamcontext",
  "version": "0.26.0",
  "description": "dreamcontext \u2014 the persistent brain for your AI agents. Remembers what you built, knows how your project works.",
  "type": "module",
  "bin": {
    "dreamcontext": "./dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "skill",
    "skill-initializer",
    "skill-curator",
    "skill-deep-research",
    "skill-sync",
    "skill-patterns",
    "skill-packs",
    "agents",
    "README.md",
    "LICENSE",
    "NOTICE",
    "install.sh"
  ],
  "scripts": {
    "build:dashboard": "cd dashboard && npm run build && cd .. && node scripts/sync-dashboard-dist.mjs",
    "build:cli": "tsup",
    "build": "npm run build:dashboard && npm run build:cli",
    "dev": "tsup --watch",
    "dev:dashboard": "cd dashboard && npm run dev",
    "test": "vitest",
    "test:e2e": "playwright test",
    "verify:people": "node scripts/verify/people-first.mjs",
    "verify:chat-steer": "node scripts/verify/chat-steer.mjs",
    "verify:chat-scroll": "node scripts/verify/chat-scroll.mjs",
    "verify:past-chats": "node scripts/verify/past-chats.mjs",
    "verify:past-chats-ui": "node scripts/verify/past-chats-ui.mjs",
    "verify:pdf-viewer": "node scripts/verify/pdf-viewer.mjs",
    "verify:claude-auth-switch": "node scripts/verify/claude-auth-switch.mjs",
    "diagrams": "node scripts/diagrams/build-all.mjs",
    "prepublishOnly": "npm run build",
    "verify:chat-toolrows": "node scripts/verify/chat-toolrows.mjs",
    "verify:chat-prose": "node scripts/verify/chat-prose.mjs",
    "gen:cli-manifest": "UPDATE_CLI_MANIFEST=1 vitest run tests/unit/cli-manifest.test.ts",
    "verify:dream-actions": "node scripts/verify/dream-actions.mjs",
    "verify:chat-shelf-ui": "node scripts/verify/chat-shelf-ui.mjs",
    "verify:chat-composer": "node scripts/verify/chat-composer-ui.mjs",
    "verify:chat-shelf": "node scripts/verify/chat-shelf.mjs",
    "verify:automation-run-chat": "node scripts/verify/automation-run-chat.mjs",
    "verify:delegate-modes": "node scripts/verify/delegate-modes.mjs",
    "verify:hypotheses": "node scripts/verify/hypotheses-ui.mjs",
    "verify:lab-board": "node scripts/verify/lab-board.mjs",
    "verify:lab-breakdown-reports": "node scripts/verify/lab-breakdown-reports.mjs",
    "verify:project-tabs": "node scripts/verify/project-tabs.mjs",
    "verify:project-chip-status": "node scripts/verify/project-chip-status.mjs",
    "verify:automations": "node scripts/verify/automations.mjs",
    "verify:task-delete": "node scripts/verify/task-delete-confirm.mjs",
    "verify:task-backlog": "node scripts/verify/task-backlog-and-tags.mjs"
  },
  "keywords": [
    "ai",
    "agent",
    "context",
    "memory",
    "brain",
    "cli",
    "claude",
    "gemini",
    "llm"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "nanoid": "^5.1.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.13.4",
    "@types/ws": "^8.18.1",
    "sharp": "^0.34.5",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "node-pty": "^1.1.0"
  }
}
