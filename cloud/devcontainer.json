{
  "name": "dreamcontext-handsfree",
  "build": { "dockerfile": "Dockerfile", "context": "." },
  "privileged": true,
  "remoteUser": "codespace",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "dreamcontext", "onAutoForward": "silent" }
  },
  "postStartCommand": "bash /opt/dc-hf/poststart.sh",
  "hostRequirements": { "cpus": 2 }
}
